# DoochyBot local agent configuration. The easiest way to fill this in is the
# wizard (pnpm doochybot:setup), which asks for the four credential values and
# finds your account id automatically. This file documents the fields for
# manual setup.
#
# You need your OWN cTrader account and your OWN Open API app; never share one
# account or an IP with another DoochyBot user (the broker forbids it).

# Demo accounts use the demo host; funded/live use live.ctraderapi.com.
# Wrong host gives CANT_ROUTE_REQUEST on account auth.
CTRADER_HOST=demo.ctraderapi.com
CTRADER_PORT=5035

# Your own Open API application: create it at https://openapi.ctrader.com/apps
# ("Add new app"), then press "Credentials" next to it and copy these two.
CLIENT_ID=
CLIENT_SECRET=

# Tokens generated on that same Credentials page for your cTrader ID, with
# access to your trading account approved.
ACCESS_TOKEN=
REFRESH_TOKEN=

# --- Accounts ---
#
# Two ways to configure the account(s) the bot trades:
#
# 1) Single account (simplest): INTERNAL account id (ctidTraderAccountId), not
#    the account number you see in the cTrader app. The wizard finds it for
#    you; manually: fill in the four values above, then run
#    "node scripts/lookup-account-id.js".
ACCOUNT_ID=

# 2) Structured account list (single OR multiple accounts). JSON array; when it
#    is set, ACCOUNT_ID is ignored.
#
#    One account is the same as ACCOUNT_ID:
#      CTRADER_ACCOUNTS=[{"login":3064718,"role":"primary"}]
#
#    Multiple accounts: list one entry per account to trade. All accounts must
#    belong to the SAME Open API app, so the single CLIENT_ID/CLIENT_SECRET and
#    ACCESS_TOKEN/REFRESH_TOKEN above reach all of them.
#      CTRADER_ACCOUNTS=[{"login":5864843,"role":"primary"},{"login":3064718,"role":"primary"}]
#
#    All entries must also be the SAME environment - all demo or all live. One
#    agent opens a single connection to one host, so mixing a demo and a live
#    account here fails account auth with CANT_ROUTE_REQUEST and the bot will
#    not start. To trade a demo and a live account together, run one agent per
#    environment (separate .env + pairing each).
#
#    Each entry takes "login" (the account number shown in cTrader, preferred -
#    resolved to its ctid automatically at startup) or "ctid" (the internal
#    ctidTraderAccountId) - one of the two is enough.
#
#    "role" values:
#      primary - traded by this DoochyBot. Several primaries run ONE combined
#                bot across all of them: shared settings, per-account risk and
#                positions, one /status showing the sum plus each account.
#      source  - copy-trade only, for the owner's VPS source node: watches this
#                account's fills and publishes them to the shared signal feed.
#                A normal user agent must NOT set this (an agent with no
#                primary role cannot trade).
#
# The setup wizard (pnpm doochybot:setup) writes a single account for you; to
# trade a second, add its entry to CTRADER_ACCOUNTS by hand afterwards.
# CTRADER_ACCOUNTS=

# The hub.
HUB_WS_URL=wss://doochy.route07.com/ws

# First run only: pairing code from sending /pair to @DoochyBot in Telegram.
# Normally not needed; the first interactive start asks for it.
# AGENT_PAIR_CODE=
